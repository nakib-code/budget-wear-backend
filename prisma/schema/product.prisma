model Product {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  price       Decimal            @db.Decimal(10, 2)
  imageUrl    String
  publicId    String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  orderItems  OrderItem[]
  inventories ProductInventory[]
}